# Set true to force deterministic synthetic data for design/demo recordings.
WINDLINE_DEMO_MODE=false
# When true, the app visibly labels synthetic data if Elexon cannot be reached.
WINDLINE_ALLOW_DEMO_FALLBACK=true
WINDLINE_CACHE_TTL_SECONDS=900
WINDLINE_REQUEST_TIMEOUT_SECONDS=45
WINDLINE_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Comma-separated origins allowed to call the backend directly.
WINDLINE_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# For a Vercel frontend, set this to the deployed backend origin in Vercel project env.
# Example: https://windline-api.onrender.com
VITE_API_BASE_URL=
